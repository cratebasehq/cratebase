{
  "name": "@cratebase/react",
  "version": "0.2.0",
  "description": "First-party React hooks for @cratebase/client: a CratebaseProvider/useCratebase context, typed useRecords/useRecord/useInfiniteRecords/useMutation/useAuth/usePresence/useSubscription, and a createCratebaseHooks<Schema>() factory for collection-name-to-record-type inference.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cratebasehq/cratebase.git",
    "directory": "sdk/js/react"
  },
  "homepage": "https://github.com/cratebasehq/cratebase/tree/main/sdk/js/react#readme",
  "bugs": "https://github.com/cratebasehq/cratebase/issues",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.typecheck.json",
    "test": "bun test"
  },
  "peerDependencies": {
    "@cratebase/client": "^0.2.0",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@cratebase/client": "^0.2.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.2"
  }
}
