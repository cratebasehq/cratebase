node_modules/
dist/
# This example's own data directory (created by `bun run dev` /
# scripts/dev.ts, alongside the repo root's own /pb_data which the top
# level .gitignore already covers).
/pb_data
# Auto-written by `CB_AUTOMIGRATE` (on by default) every time schema.json
# is pushed — schema.json is this project's real source of truth, so
# these migration files (which just replay the same collections on the
# next fresh `pb_data`) aren't checked in.
/pb_migrations
# Generated by scripts/gen-schema.ts and pushed with `cratebase schema
# push` — scripts/gen-schema.ts is the real source of truth, so the
# generated file isn't checked in (same reasoning as cratebase-types.d.ts
# below).
/schema.json
# Generated by `cratebase typegen` (scripts/typegen.sh, or the --dev +
# CB_TYPEGEN_OUT watch) — regenerate with `bun run typegen`.
src/cratebase-types.d.ts
