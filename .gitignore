/target
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example
/data
# The default data directory: running `cratebase serve` from the repo root
# creates it, and `.secret` inside it is a real credential.
/pb_data
node_modules/
.DS_Store
*.log

# The built dashboard IS committed, the way PocketBase commits `ui/dist`.
# That is what makes `cargo build` alone produce a working binary from a
# fresh clone: no bun, no node, no separate frontend step for anyone who
# only wants to run the server. CI rebuilds it and fails if what is
# committed has drifted, so a stale bundle cannot ship silently.
web/admin/node_modules
web/email/dist/*
!web/email/dist/.gitkeep
web/email/node_modules

# sdk/js publishes from this dist, but it is a build artifact, not
# something to commit — unlike web/admin/dist (see above).
sdk/js/dist/

# @cratebase/extras' dist/ is a real npm build artifact (unlike
# web/admin's committed dashboard bundle) — CI builds it fresh from
# source before every publish, so it never needs to be committed.
sdk/js/extras/dist

# @cratebase/schema-codegen's dist/ is likewise a build artifact, not
# something to commit — CI builds it fresh from source before every
# publish.
tools/schema-codegen/dist

# @cratebase/client's dist/ — same reasoning as extras/schema-codegen
# above: a real npm build artifact, rebuilt fresh by CI before publish.
sdk/js/client/dist

# @cratebase/react's dist/ — same reasoning as client/extras/schema-codegen
# above: a real npm build artifact, rebuilt fresh by CI before publish.
sdk/js/react/dist

# create-cratebase's dist/ — same reasoning as the sdk packages above.
packages/create-cratebase/dist

# TypeScript incremental build info for the zero-build example apps
# (examples/kanban's own tsconfig `-b` run) — a local build cache, not
# something to commit.
*.tsbuildinfo

# Agent skills installed via `npx skills add` — local dev aids, not
# part of the shipped product; keep them out of the open-source repo.
# Exception: .claude/skills/cratebase/ is authored here and shipped
# intentionally so it's available to anyone who opens this repo.
# Exception: .claude/skills/motion-reel/ is the packaged launch-film
# pipeline from marketing/video/ — also authored here, also shipped.
.claude/skills/
!.claude/skills/cratebase/
!.claude/skills/cratebase/**
!.claude/skills/motion-reel/
!.claude/skills/motion-reel/**
.agents/skills/
skills-lock.json

# Claude Code worktrees
.claude/worktrees/

# marketing/video/ — the launch-film render engine (marketing/video/docs/README.md
# has the pipeline). Engine source, docs and Docker/render scripts are committed;
# everything below is a large or regenerable artifact and is not.
marketing/video/node_modules/
marketing/video/out/
marketing/video/refs/
# Captured real UI screenshots + the local Cratebase demo data dir used to take
# them: large, regenerable by marketing/video/capture/, never hand-authored.
marketing/video/capture/shots/
marketing/video/capture/demo-data/
# Large source assets (raw screenshots, exported audio stems, fonts vendored
# for the render). Small hand-authored/derived files (manifests, thumbnails
# under a few KB) may still be force-added case by case.
marketing/video/assets/*
!marketing/video/assets/.gitkeep
!marketing/video/assets/manifest.json
