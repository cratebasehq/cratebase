/target
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example
/data
node_modules/
.DS_Store
*.log

# Built frontend output isn't committed — run `bun run admin:build` to
# produce it locally, or let the Dockerfile do it.
# `.gitkeep` keeps the directory present so `cargo build`'s rust-embed
# `#[folder = "web/admin/dist"]` has somewhere to point at on a fresh clone.
web/admin/dist/*
!web/admin/dist/.gitkeep
web/admin/node_modules
web/email/dist/*
!web/email/dist/.gitkeep
web/email/node_modules

# Agent skills installed via `npx skills add` — local dev aids, not
# part of the shipped product; keep them out of the open-source repo.
.claude/skills/
.agents/skills/
skills-lock.json
