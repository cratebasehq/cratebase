---
/**
 * A tabbed code block: one set of triggers, one panel shown at a time.
 * Vanilla JS, no framework — a handful of buttons and a `hidden` toggle.
 * Each <script> block below is deduplicated by Astro per-page regardless
 * of how many <CodeTabs> instances render, so this scales to many tab
 * groups on one page for free.
 */
interface Tab {
  label: string;
  code: string;
  lang?: string;
}
interface Props {
  tabs: Tab[];
  /** Distinguishes multiple tab groups on one page for scoped JS targeting. */
  groupId: string;
}
const { tabs, groupId } = Astro.props;
---

<div class="code-tabs" data-code-tabs={groupId}>
  <div class="code-tabs-bar" role="tablist" aria-label="Code example">
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          class="code-tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`${groupId}-panel-${i}`}
          id={`${groupId}-tab-${i}`}
          data-index={i}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab, i) => (
      <pre
        class="code-panel mono"
        role="tabpanel"
        id={`${groupId}-panel-${i}`}
        aria-labelledby={`${groupId}-tab-${i}`}
        hidden={i !== 0}
      ><code set:html={tab.code} /></pre>
    ))
  }
</div>

<style>
  .code-tabs {
    background: var(--color-harbor);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  :root[data-theme="dark"] .code-tabs {
    background: #0c1a29;
    box-shadow: inset 0 0 0 1px rgba(238, 241, 244, 0.08);
  }
  .code-tabs-bar {
    display: flex;
    gap: 0.25rem;
    padding: 0.6rem 0.75rem 0;
    overflow-x: auto;
  }
  .code-tab {
    appearance: none;
    background: transparent;
    border: none;
    color: rgba(238, 241, 244, 0.55);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.55rem 0.9rem;
    border-radius: 0.5rem 0.5rem 0 0;
    cursor: pointer;
    white-space: nowrap;
    transition: color 140ms var(--ease-house), background 140ms var(--ease-house);
  }
  .code-tab:hover {
    color: #eef1f4;
  }
  .code-tab[aria-selected="true"] {
    color: #eef1f4;
    background: rgba(238, 241, 244, 0.08);
  }
  .code-tab:focus-visible {
    outline: 2px solid var(--color-crate);
    outline-offset: -2px;
  }
  .code-panel {
    margin: 0;
    padding: 1.15rem 1.35rem 1.5rem;
    color: #eef1f4;
    font-size: 0.85rem;
    line-height: 1.65;
    overflow-x: auto;
  }
</style>

<script>
  // One delegated listener per tab group handles all its buttons.
  document.querySelectorAll<HTMLElement>("[data-code-tabs]").forEach((group) => {
    const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>(".code-tab"));
    const panels = Array.from(group.querySelectorAll<HTMLElement>(".code-panel"));
    group.querySelector(".code-tabs-bar")?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".code-tab");
      if (!btn) return;
      const index = Number(btn.dataset.index);
      tabs.forEach((t, i) => t.setAttribute("aria-selected", String(i === index)));
      panels.forEach((p, i) => (p.hidden = i !== index));
    });
  });
</script>
