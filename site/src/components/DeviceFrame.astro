---
/**
 * A refined browser chrome frame around a real product screenshot.
 * Renders a light-theme and a dark-theme capture stacked in the same box;
 * CSS shows whichever matches the page's current theme (and repaints
 * instantly on the nav's theme toggle — no re-fetch, both are already
 * loaded at the same optimized sizes via <Picture>).
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  /** Address bar text, e.g. "localhost:8090/_/settings/email" */
  path?: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
}
const {
  light,
  dark,
  alt,
  path = "localhost:8090/_/",
  widths = [480, 768, 1040, 1400],
  sizes = "(min-width: 1100px) 640px, 90vw",
  eager = false,
} = Astro.props;
---

<figure class="device">
  <div class="device-bar">
    <span class="device-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="device-url mono">{path}</span>
  </div>
  <div class="device-screen">
    <Picture
      src={light}
      alt={alt}
      formats={["avif", "webp"]}
      widths={widths}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      class="shot shot-light"
    />
    <Picture
      src={dark}
      alt=""
      aria-hidden="true"
      formats={["avif", "webp"]}
      widths={widths}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      class="shot shot-dark"
    />
  </div>
</figure>

<style>
  .device {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-white);
    border: 1px solid var(--color-hairline);
    box-shadow: 0 1px 2px rgba(14, 34, 56, 0.04);
  }
  :root[data-theme="dark"] .device {
    background: var(--color-panel);
  }
  .device-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem;
    background: var(--color-fog);
    border-bottom: 1px solid var(--color-hairline);
  }
  :root[data-theme="dark"] .device-bar {
    background: #0d1c2b;
    border-color: var(--color-border);
  }
  .device-dots {
    display: flex;
    gap: 0.32rem;
    flex-shrink: 0;
  }
  .device-dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-hairline);
  }
  :root[data-theme="dark"] .device-dots i {
    background: rgba(238, 241, 244, 0.16);
  }
  .device-url {
    flex: 1;
    min-width: 0;
    background: var(--color-white);
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.72rem;
    color: var(--color-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :root[data-theme="dark"] .device-url {
    background: var(--color-panel);
    border-color: var(--color-border);
  }
  .device-screen {
    position: relative;
    line-height: 0;
  }
  .device-screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot-dark {
    display: none;
  }
  :root[data-theme="dark"] .shot-light {
    display: none;
  }
  :root[data-theme="dark"] .shot-dark {
    display: block;
  }
</style>
