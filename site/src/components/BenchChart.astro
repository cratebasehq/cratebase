---
/**
 * Horizontal bar chart of Cratebase req/s, from the idle-host run recorded
 * in benchmarks/README.md (2026-09-04). Data-ink stays in the neutral/orange
 * chart tokens used by the swatch. A full data table ships alongside for
 * exact numbers, screen readers, print and forced-colors mode.
 */
interface Row {
  category: string;
  detail: string;
  conc: number;
  cb: number;
}
const rows: Row[] = [
  { category: "search", detail: "GET .../records, perPage=30", conc: 50, cb: 49986 },
  { category: "search-auth", detail: "same, authenticated", conc: 100, cb: 38768 },
  { category: "search-wide", detail: "perPage=200", conc: 100, cb: 16414 },
  { category: "create", detail: "POST .../records", conc: 100, cb: 11960 },
  { category: "delete", detail: "DELETE .../records/:id", conc: 100, cb: 11321 },
];
const max = Math.max(...rows.map((r) => r.cb));
const fmt = (n: number) => n.toLocaleString("en-US");
---

<div class="bench-chart">
  <div class="bench-legend">
    <span class="legend-item"><i class="swatch swatch-cb"></i>Cratebase</span>
    <span class="legend-note">requests/sec, higher is better — median of 3 runs</span>
  </div>

  <div class="bench-rows" role="img" aria-label="Bar chart of Cratebase throughput across five request categories; see the data table below for exact figures.">
    {
      rows.map((r) => (
        <div class="bench-row">
          <div class="bench-row-label">
            <span class="mono cat">{r.category}</span>
            <span class="detail">{r.detail} · c{r.conc}</span>
          </div>
          <div class="bench-bars">
            <div class="bar-track">
              <div class="bar bar-cb" style={`--v:${r.cb / max}`} title={`Cratebase: ${fmt(r.cb)} req/s`}></div>
              <span class="bar-value mono">{fmt(r.cb)}</span>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <details class="bench-table-toggle">
    <summary>View as a data table</summary>
    <div class="bench-table-scroll">
    <table class="bench-table">
      <caption class="sr-only">Cratebase requests per second by category</caption>
      <thead>
        <tr><th scope="col">Category</th><th scope="col">Concurrency</th><th scope="col">Cratebase req/s</th></tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="mono">{r.category}</td>
            <td class="mono">{r.conc}</td>
            <td class="mono">{fmt(r.cb)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </details>
</div>

<style>
  .bench-chart {
    display: grid;
    gap: 1.25rem;
  }
  .bench-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.85rem;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
  }
  .swatch {
    width: 0.85rem;
    height: 0.6rem;
    border-radius: 0.15rem;
    display: inline-block;
  }
  .swatch-cb {
    background: #e0692a;
  }
  :root[data-theme="dark"] .swatch-cb {
    background: #d9652a;
  }
  .legend-note {
    color: var(--color-text-secondary);
    font-size: 0.8rem;
  }

  .bench-rows {
    display: grid;
    gap: 1.1rem;
  }
  .bench-row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1rem;
    align-items: center;
  }
  .bench-row-label {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .bench-row-label .cat {
    font-weight: 700;
    font-size: 0.88rem;
  }
  .bench-row-label .detail {
    font-size: 0.72rem;
    color: var(--color-text-secondary);
  }
  .bench-bars {
    display: grid;
    gap: 0.3rem;
  }
  .bar-track {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 1.25rem;
  }
  .bar {
    height: 100%;
    width: calc((100% - 4.5rem) * var(--v));
    min-width: 4px;
    border-radius: 2px 4px 4px 2px;
    transition: width 700ms var(--ease-out);
  }
  .bar-cb {
    background: #e0692a;
  }
  :root[data-theme="dark"] .bar-cb {
    background: #d9652a;
  }
  .bar-value {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
  }

  .bench-table-toggle {
    font-size: 0.85rem;
  }
  .bench-table-toggle summary {
    cursor: pointer;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .bench-table-scroll {
    overflow-x: auto;
  }
  .bench-table {
    margin-top: 0.75rem;
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    font-size: 0.82rem;
  }
  .bench-table th,
  .bench-table td {
    text-align: left;
    padding: 0.45rem 0.7rem;
    border-bottom: 1px solid var(--color-border);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 640px) {
    .bench-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem 1rem;
    }
    .bench-bars {
      grid-row: 2;
    }
  }
</style>
