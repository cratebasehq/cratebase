---
/**
 * "Schema to typed client" — three steps, one window. Each step shows its
 * pane: the real `cratebase dev` banner (crates/server/src/main.rs,
 * print_dev_banner), the real generated types for the demo `posts`
 * collection, and an app file that types itself out, pops a completion list
 * sourced from those types, and flags a create() that's missing a required
 * field.
 *
 * Steps auto-advance while the window is on screen and stop the moment the
 * reader picks one. Under prefers-reduced-motion nothing auto-advances and
 * every pane renders in its finished state.
 */
const steps = [
  { id: "dev", cmd: "cratebase dev", body: "Provisions a superuser, applies schema.json, and writes the types file." },
  { id: "types", cmd: "cratebase-types.d.ts", body: "One type per collection, rewritten on every schema change while dev runs." },
  { id: "app", cmd: "app.ts", body: "Your editor now knows every field, and the compiler catches bad writes." },
];
---

<div class="tf" data-typed-flow>
  <ol class="tf-steps" role="tablist" aria-label="From schema to typed client">
    {
      steps.map((s, i) => (
        <li role="presentation">
          <button
            type="button"
            role="tab"
            class="tf-step"
            id={`tf-tab-${s.id}`}
            aria-controls={`tf-pane-${s.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-step={i}
          >
            <span class="tf-n">{i + 1}</span>
            <span class="tf-cmd">{s.cmd}</span>
            <span class="tf-body">{s.body}</span>
            <span class="tf-progress" aria-hidden="true"></span>
          </button>
        </li>
      ))
    }
  </ol>

  <div class="tf-win">
    <div class="tf-bar" aria-hidden="true">
      <span class="tf-dots"><i></i><i></i><i></i></span>
      <span class="tf-file" data-tf-file>zsh</span>
    </div>

    <div class="tf-pane is-active" id="tf-pane-dev" role="tabpanel" aria-labelledby="tf-tab-dev" data-name="zsh">
<pre><code><span class="l"><span class="p">$</span> curl -fsSL https://cratebase.dev/install.sh | sh</span>
<span class="l dim">Downloading Cratebase 0.6.0 for x86_64-unknown-linux-musl...</span>
<span class="l dim">Cratebase 0.6.0 installed to ~/.local/bin/cratebase</span>
<span class="l"><span class="p">$</span> cratebase dev</span>
<span class="l"></span>
<span class="l">  cratebase dev</span>
<span class="l dim">  ------------------------------------------------------------</span>
<span class="l">  API:            <span class="s">http://127.0.0.1:8090/api/</span></span>
<span class="l">  Dashboard:      <span class="s">http://127.0.0.1:8090/_/</span></span>
<span class="l">  Superuser:      admin@localhost / ••••••••••  <span class="dim">(generated; change it)</span></span>
<span class="l">  Schema:         applied (3 collection(s))</span>
<span class="l">  Types:          <span class="hl">./cratebase-types.d.ts</span></span>
<span class="l">  Mail inbox:     <span class="s">http://127.0.0.1:8090/api/dev/mails</span></span></code></pre>
    </div>

    <div class="tf-pane" id="tf-pane-types" role="tabpanel" aria-labelledby="tf-tab-types" data-name="cratebase-types.d.ts" hidden>
<pre><code><span class="l c">// Generated by `cratebase typegen`. Do not edit by hand.</span>
<span class="l"></span>
<span class="l"><span class="k">export type</span> <span class="t">PostsRecord</span> = {'{'}</span>
<span class="l">  id: <span class="t">string</span>;</span>
<span class="l">  title: <span class="t">string</span>;</span>
<span class="l">  body?: <span class="t">string</span>;</span>
<span class="l">  published?: <span class="t">boolean</span>;</span>
<span class="l">  author?: <span class="t">string</span>;</span>
<span class="l">  expand?: {'{'} author?: <span class="t">UsersRecord</span> {'}'};</span>
<span class="l">{'}'};</span>
<span class="l"></span>
<span class="l"><span class="k">export type</span> <span class="t">PostsCreate</span> = {'{'} title: <span class="t">string</span>; body?: <span class="t">string</span>; published?: <span class="t">boolean</span>; author?: <span class="t">string</span> {'}'};</span>
<span class="l"></span>
<span class="l"><span class="k">export type</span> <span class="t">Schema</span> = {'{'} users: <span class="t">UsersRecord</span>; places: <span class="t">PlacesRecord</span>; posts: <span class="t">PostsRecord</span> {'}'};</span></code></pre>
    </div>

    <div class="tf-pane tf-app" id="tf-pane-app" role="tabpanel" aria-labelledby="tf-tab-app" data-name="app.ts" hidden>
<pre><code><span class="l ty" style="--n:49;--d:0"><span class="k">import</span> {'{'} createClient {'}'} <span class="k">from</span> <span class="s">"@cratebase/client"</span>;</span>
<span class="l ty" style="--n:63;--d:1"><span class="k">import type</span> {'{'} <span class="t">Schema</span>, <span class="t">SchemaCreate</span> {'}'} <span class="k">from</span> <span class="s">"./cratebase-types"</span>;</span>
<span class="l"></span>
<span class="l ty" style="--n:70;--d:2"><span class="k">const</span> cb = createClient&lt;<span class="t">Schema</span>, <span class="t">SchemaCreate</span>&gt;(<span class="s">"http://localhost:8090"</span>);</span>
<span class="l"></span>
<span class="l ty" style="--n:74;--d:3"><span class="k">const</span> {'{'} items {'}'} = <span class="k">await</span> cb.collection(<span class="s">"posts"</span>).list({'{'} sort: <span class="s">"-published"</span> {'}'});</span>
<span class="l ty" style="--n:43;--d:4">items[0].title; <span class="c">// (property) title: string</span></span>
<span class="l"></span>
<span class="l ty" style="--n:56;--d:5"><span class="k">await</span> cb.collection(<span class="s">"posts"</span>).create(<span class="err">{'{'} published: <span class="k">true</span> {'}'}</span>);</span>
<span class="l tf-diag"><span class="x" aria-hidden="true">✕</span> Property 'title' is missing in type '{'{'} published: true; {'}'}' but required in type 'PostsCreate'.</span></code><span class="tf-complete" aria-hidden="true"><span>"-author"</span><span>"-body"</span><span>"-created"</span><span class="on">"-published"</span><span>"-title"</span></span></pre>
    </div>
  </div>
</div>

<style>
  .tf {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }
  .tf-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .tf-step {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.15rem 0.75rem;
    width: 100%;
    padding: 1rem 1.1rem 1.1rem;
    text-align: left;
    background: transparent;
    border: 1px solid rgba(238, 241, 244, 0.1);
    border-radius: 0.9rem;
    color: #eef1f4;
    font: inherit;
    cursor: pointer;
    overflow: hidden;
    transition:
      background 200ms var(--ease-house),
      border-color 200ms var(--ease-house);
  }
  .tf-step:hover {
    border-color: rgba(238, 241, 244, 0.24);
  }
  .tf-step[aria-selected="true"] {
    background: rgba(238, 241, 244, 0.06);
    border-color: rgba(238, 241, 244, 0.28);
  }
  .tf-step:focus-visible {
    outline: 2px solid var(--color-crate);
    outline-offset: 2px;
  }
  .tf-n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1px solid rgba(238, 241, 244, 0.3);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .tf-step[aria-selected="true"] .tf-n {
    background: var(--color-crate);
    border-color: var(--color-crate);
    color: var(--color-harbor);
    font-weight: 700;
  }
  .tf-cmd {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .tf-body {
    font-size: 0.86rem;
    line-height: 1.45;
    color: #a9b8c7;
  }
  .tf-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--color-crate);
    transform: scaleX(0);
    transform-origin: left;
  }
  .tf.is-auto .tf-step[aria-selected="true"] .tf-progress {
    animation: tf-progress var(--tf-dwell, 6s) linear forwards;
  }
  @keyframes tf-progress {
    to {
      transform: scaleX(1);
    }
  }

  .tf-win {
    min-width: 0;
    border-radius: 1rem;
    background: #06101a;
    box-shadow:
      0 0 0 1px rgba(238, 241, 244, 0.12),
      0 40px 80px -30px rgba(0, 0, 0, 0.7);
    overflow: hidden;
  }
  .tf-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 2.5rem;
    padding-inline: 1rem;
    border-bottom: 1px solid rgba(238, 241, 244, 0.08);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #a9b8c7;
  }
  .tf-dots {
    display: flex;
    gap: 0.35rem;
  }
  .tf-dots i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: rgba(238, 241, 244, 0.18);
  }
  .tf-pane {
    min-height: 20.5rem;
  }
  .tf-pane pre {
    margin: 0;
    padding: 1.25rem 1.4rem 1.5rem;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.7;
    color: #e3e9ef;
  }
  /* grid drops the whitespace-only text between line spans, so each .l
     is exactly one row even inside <pre>. */
  .tf-pane code {
    display: grid;
  }
  .tf-pane .l {
    display: block;
    min-height: 1.7em;
    white-space: pre;
  }
  .p {
    color: var(--color-crate);
    user-select: none;
  }
  .dim,
  .c {
    color: #8193a6;
  }
  .s {
    color: #9ed9b5;
  }
  .k {
    color: #ffb88a;
  }
  .t {
    color: #9cc7f0;
  }
  .hl {
    color: #06101a;
    background: #ffb88a;
    padding: 0 0.3em;
    border-radius: 0.2em;
  }
  .err {
    text-decoration: underline wavy #ff7b7b;
    text-underline-offset: 4px;
    text-decoration-skip-ink: none;
  }
  .tf-diag {
    margin-top: 0.4rem;
    padding: 0.55rem 0.8rem;
    border-radius: 0.5rem;
    background: rgba(255, 123, 123, 0.1);
    box-shadow: inset 2px 0 0 #ff7b7b;
    color: #ffc9c9;
    white-space: pre-wrap !important;
  }
  .x {
    color: #ff7b7b;
    margin-right: 0.35rem;
  }
  .tf-app pre {
    position: relative;
  }
  .tf-complete {
    position: absolute;
    top: calc(1.25rem + 6 * 1.7em);
    left: calc(1.4rem + 60ch);
    display: grid;
    padding: 0.3rem;
    border-radius: 0.45rem;
    background: #10202f;
    box-shadow:
      0 0 0 1px rgba(238, 241, 244, 0.14),
      0 16px 30px -12px rgba(0, 0, 0, 0.8);
    z-index: 2;
    line-height: 1.55;
  }
  .tf-complete span {
    padding: 0 0.6rem;
    border-radius: 0.3rem;
    color: #c9d4de;
  }
  .tf-complete .on {
    background: rgba(156, 199, 240, 0.18);
    color: #fff;
  }

  /* Typing: each .ty line reveals character by character (monospace, so
     `ch` is exact), one line after another; the completion list shows
     while line 4 types and closes as it finishes; the diagnostic lands last. */
  @media (prefers-reduced-motion: no-preference) {
    .tf.is-auto .tf-app.is-active .ty {
      width: 0;
      overflow: hidden;
      animation: tf-type calc(var(--n) * 22ms) steps(var(--n)) forwards;
      animation-delay: calc(var(--d) * 900ms + 200ms);
    }
    .tf.is-auto .tf-app.is-active .tf-complete {
      opacity: 0;
      animation: tf-flash 1.9s var(--ease-house) forwards;
      animation-delay: calc(3 * 900ms + 1100ms);
    }
    .tf.is-auto .tf-app.is-active .tf-diag {
      opacity: 0;
      animation: tf-fade 400ms var(--ease-out) forwards;
      animation-delay: calc(6 * 900ms + 500ms);
    }
    .tf.is-auto .tf-app.is-active .err {
      text-decoration-color: transparent;
      animation: tf-squiggle 300ms linear forwards;
      animation-delay: calc(6 * 900ms + 300ms);
    }
  }
  @keyframes tf-type {
    from {
      width: 0;
    }
    to {
      width: calc(var(--n) * 1ch);
    }
  }
  @keyframes tf-flash {
    0%,
    100% {
      opacity: 0;
    }
    12%,
    82% {
      opacity: 1;
    }
  }
  @keyframes tf-fade {
    to {
      opacity: 1;
    }
  }
  @keyframes tf-squiggle {
    to {
      text-decoration-color: #ff7b7b;
    }
  }
  /* Outside the animation the completion list stays closed. */
  .tf:not(.is-auto) .tf-complete {
    display: none;
  }

  @media (max-width: 900px) {
    .tf {
      grid-template-columns: 1fr;
    }
    .tf-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tf-step {
      grid-template-columns: 1fr;
      padding: 0.75rem;
    }
    .tf-n {
      grid-row: auto;
    }
    .tf-body {
      display: none;
    }
    .tf-cmd {
      font-size: 0.75rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .tf-pane {
      min-height: 0;
    }
    .tf-pane pre {
      font-size: 0.74rem;
      padding: 1rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-typed-flow]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".tf-step"));
    const panes = Array.from(root.querySelectorAll<HTMLElement>(".tf-pane"));
    const fileEl = root.querySelector<HTMLElement>("[data-tf-file]");
    const dwell = [5200, 5200, 11500];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;
    let timer: number | undefined;
    let auto = !reduced;

    const show = (i: number, focus = false) => {
      current = i;
      tabs.forEach((t, j) => {
        t.setAttribute("aria-selected", String(j === i));
        t.tabIndex = j === i ? 0 : -1;
      });
      panes.forEach((p, j) => {
        p.hidden = j !== i;
        // Re-trigger the pane's CSS animations by toggling the class.
        p.classList.remove("is-active");
        if (j === i) {
          void p.offsetWidth;
          p.classList.add("is-active");
        }
      });
      if (fileEl) fileEl.textContent = panes[i].dataset.name ?? "";
      if (focus) tabs[i].focus();
      root.style.setProperty("--tf-dwell", `${dwell[i]}ms`);
      schedule();
    };
    const schedule = () => {
      window.clearTimeout(timer);
      if (!auto) return;
      timer = window.setTimeout(() => show((current + 1) % tabs.length), dwell[current]);
    };
    const stopAuto = () => {
      auto = false;
      root.classList.remove("is-auto");
      window.clearTimeout(timer);
    };

    tabs.forEach((t, i) =>
      t.addEventListener("click", () => {
        stopAuto();
        show(i);
      }),
    );
    root.querySelector(".tf-steps")?.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      if (k !== "ArrowDown" && k !== "ArrowUp" && k !== "ArrowRight" && k !== "ArrowLeft") return;
      e.preventDefault();
      stopAuto();
      const dir = k === "ArrowDown" || k === "ArrowRight" ? 1 : -1;
      show((current + dir + tabs.length) % tabs.length, true);
    });

    if (!auto) return;
    // Start only once the window is actually on screen; pause when it leaves.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!auto) return;
          if (entry.isIntersecting) {
            root.classList.add("is-auto");
            show(current);
          } else {
            window.clearTimeout(timer);
          }
        }
      },
      { threshold: 0.4 },
    );
    io.observe(root);
  });
</script>
