---
import LandingLayout from "../layouts/LandingLayout.astro";

interface Item {
  name: string;
  body: string;
  href: string;
  code?: string;
}
interface Group {
  id: string;
  title: string;
  intro: string;
  items: Item[];
}

const groups: Group[] = [
  {
    id: "data",
    title: "Collections & data",
    intro: "A collection is a real SQL table, and the query surface over it is a filter language compiled straight into the query plan — not an ORM layer in front of one.",
    items: [
      { name: "Dynamic collections", body: "Define fields through the API/dashboard; Cratebase creates and migrates the real SQL table for you.", href: "/docs/concepts/collections/", code: "POST /api/collections" },
      { name: "Field types", body: "Text, number, bool, email, url, date, select, JSON, relation, file, password, geoPoint, and more.", href: "/docs/concepts/fields/" },
      { name: "API rules", body: "A small filter-expression language (owner = @request.auth.id) for list/view/create/update/delete access, enforced in SQL.", href: "/docs/concepts/api-rules/", code: "listRule, viewRule, ..." },
      { name: "Filter syntax", body: "The same expression language powers rules, ?filter=, and RPC WHERE clauses — learn it once.", href: "/docs/concepts/filter-syntax/" },
      { name: "Full-text search", body: "?search= on any collection — SQLite FTS5 or Postgres tsvector + GIN, kept in sync automatically as fields change.", href: "/docs/database/full-text-search/", code: "?search=espresso" },
      { name: "Custom SQL RPC", body: "A named, parameterized, rule-gated SQL endpoint for the GROUP BY, window function, or PostGIS query a filter can't express.", href: "/docs/database/custom-sql-rpc/", code: "cb.rpc(name, params)" },
      { name: "Geo & nearest queries", body: "geoDistance(...) radius filters and nearest-first sorts, GiST-indexed automatically once PostGIS is installed.", href: "/docs/database/geo-queries/", code: "sort=geoDistance(...)" },
      { name: "Database extensions", body: "Enable Postgres extensions — PostGIS, pgvector, pg_trgm — from the dashboard, one API call away.", href: "/docs/database/extensions/", code: "GET/POST/DELETE /api/db/extensions" },
      { name: "Batch API", body: "Several record create/update/upsert/delete calls in one HTTP round trip and one SQL transaction — all commit or none do.", href: "/docs/concepts/batch-api/", code: "POST /api/batch" },
      { name: "Records API", body: "List, filter, sort, expand relations, and paginate any collection over a consistent REST shape.", href: "/docs/concepts/records-api/" },
      { name: "Schema as code", body: "Pull the live schema to a checked-in JSON file, push it back with a dry-run plan that flags destructive changes.", href: "/docs/extending/schema-as-code/", code: "cratebase schema pull / push" },
      { name: "Typegen, built in", body: "One TypeScript type per collection, generated by the binary itself — CLI, REST endpoint, or a --dev watch.", href: "/docs/extending/schema-codegen/", code: "cratebase typegen" },
    ],
  },
  {
    id: "auth",
    title: "Auth & security",
    intro: "Any collection can be type: \"auth\" and gets a full session model for free — registration is just creating a record.",
    items: [
      { name: "Password auth", body: "auth-with-password and auth-refresh, with email verification and password reset built in.", href: "/docs/concepts/authentication/password-auth/" },
      { name: "Email OTP", body: "Passwordless sign-in with a one-time code — always answers 200, even for an unknown address, so it can't enumerate accounts.", href: "/docs/concepts/authentication/otp/" },
      { name: "Magic link", body: "A single-use sign-in link instead of a password or a typed-back code.", href: "/docs/concepts/authentication/magic-link/" },
      { name: "TOTP 2FA", body: "RFC 6238 authenticator-app 2FA with backup codes, layered onto any first factor.", href: "/docs/concepts/authentication/totp/" },
      { name: "OAuth2 presets", body: "Google, Apple, GitHub, Microsoft, Discord, GitLab, Facebook, X, LinkedIn, Slack, Twitch, Spotify — built in.", href: "/docs/concepts/authentication/oauth2/" },
      { name: "Generic OIDC", body: "Point Cratebase at any OpenID Connect issuer that isn't one of the built-in presets.", href: "/docs/concepts/authentication/oidc/" },
      { name: "MFA", body: "A challenge-based second-factor gate shared by TOTP and any other MFA method a collection enables.", href: "/docs/concepts/authentication/mfa/" },
      { name: "Sessions", body: "JWT-based sessions with refresh, independent of which first factor was used to sign in.", href: "/docs/concepts/authentication/sessions/" },
      { name: "Cookie sessions (SSR)", body: "The official SDK's standard SSR pattern — a fresh client per request, auth hydrated from a cookie — works unmodified.", href: "/docs/concepts/authentication/cookie-sessions/" },
      { name: "Linked accounts", body: "Manage multiple OAuth providers linked to the same record.", href: "/docs/concepts/authentication/linked-accounts/" },
      { name: "Superuser impersonation", body: "A superuser can mint a session as another user for support/debugging, audited.", href: "/docs/concepts/authentication/impersonation/" },
      { name: "New-location login alerts", body: "_authOrigins tracks known sign-in origins and emails on a new one.", href: "/docs/concepts/authentication/login-alerts/" },
      { name: "Bans", body: "Suspend an auth record without deleting it.", href: "/docs/concepts/authentication/bans/" },
      { name: "API keys", body: "Dashboard-minted keys as ordinary identities — for agents, CI, and services.", href: "/docs/concepts/authentication/api-keys/", code: "Settings → API keys" },
      { name: "Teams", body: "_teams / _team_members for scoping an app collection to a workspace via rules.", href: "/docs/concepts/authentication/teams/", code: "_team_members" },
      { name: "Superusers & roles", body: "The _superusers collection and how superuser-only endpoints are gated.", href: "/docs/concepts/authentication/superusers-roles/" },
    ],
  },
  {
    id: "email",
    title: "Email platform",
    intro: "An editable _emailTemplates collection with a real visual editor — not an HTML textarea — and a send API a frontend can call directly.",
    items: [
      { name: "Visual template editor", body: "Headings, buttons, columns, images, a theme tab, and live preview, built on React Email Editor.", href: "/docs/email/templates/" },
      { name: "Send API + sendRule", body: "cb.mails.send(...) is callable from a signed-in or anonymous app user when a template's sendRule allows it.", href: "/docs/email/sending/", code: "cb.mails.send(...)" },
      { name: "No-code triggers", body: "Fire a template automatically on a record create/update/delete, no hook file required.", href: "/docs/email/triggers/" },
      { name: "Mail log", body: "Every send — API, trigger, or hook-originated — is logged to _mailLog.", href: "/docs/email/mail-log/" },
      { name: "SMTP & Resend", body: "Pluggable delivery backend: Resend's API, plain SMTP, or log-only for local dev.", href: "/docs/email/smtp-and-resend/" },
    ],
  },
  {
    id: "files",
    title: "Files & storage",
    intro: "Local disk by default; switch to any S3-compatible bucket with three environment variables.",
    items: [
      { name: "Local or S3 storage", body: "AWS S3, Cloudflare R2, Backblaze B2, or self-hosted RustFS/MinIO — one driver swap.", href: "/docs/concepts/files/" },
      { name: "Presigned direct uploads", body: "Upload straight to storage and claim it with a single-use token — no multipart round trip through your server.", href: "/docs/sdk/files/", code: "cb.files.upload(file, { collection, field })" },
      { name: "Image transforms", body: "?w=&h=&fit=&format=&q= on the files route, independent of the existing thumbnail sizes.", href: "/docs/reference/rest-api/files/" },
      { name: "Per-user storage quota", body: "Cap the bytes an auth record may store via the direct-upload flow, scoped by an ownerField.", href: "/docs/reference/rest-api/file-manager/" },
    ],
  },
  {
    id: "realtime",
    title: "Realtime",
    intro: "Subscribe to a collection or a single record over SSE; get events as they happen, filtered server-side by the same rules as everything else.",
    items: [
      { name: "Live subscriptions", body: "create/update/delete events over a streamed fetch response — no EventSource polyfill, works server-side too.", href: "/docs/concepts/realtime/", code: "GET /api/realtime" },
      { name: "Cross-node on Postgres", body: "LISTEN/NOTIFY fans events out across app instances — a write on one reaches a subscriber on another.", href: "/docs/sdk/realtime/" },
      { name: "Presence & notifications", body: "Presence tracking and in-app notification channels on the same realtime connection you already have.", href: "/docs/sdk/react/" },
    ],
  },
  {
    id: "automation",
    title: "Automation & extending",
    intro: "Drop a *.pb.js file next to your data directory and get PocketBase's own hook API, plus cron, queue, and webhooks.",
    items: [
      { name: "JS hooks", body: "onRecordCreate/onRecordUpdate-style lifecycle hooks and routerAdd for custom endpoints, on an embedded QuickJS runtime.", href: "/docs/extending/js-hooks/", code: "onRecordCreate, routerAdd" },
      { name: "JS migrations", body: "pb_migrations/*.js with PocketBase's migrate(up, down) API — apply, revert, or scaffold from the CLI.", href: "/docs/reference/cli/", code: "cratebase migrate up/down/create" },
      { name: "Cron jobs", body: "A _cron_jobs record is a schedule plus raw SQL, reactive with no redeploy.", href: "/docs/extending/cron-jobs/", code: "_cron_jobs" },
      { name: "Queue", body: "An opt-in durable job queue with retry-with-backoff and stale-job reclaim.", href: "/docs/extending/queue/", code: "_queue_jobs" },
      { name: "Outgoing webhooks", body: "Signed HTTP callbacks on record events, verifiable on the receiving end.", href: "/docs/extending/outgoing-webhooks/", code: "X-Cratebase-Signature" },
      { name: "Incoming webhooks", body: "A worked pattern for verifying an inbound HMAC-signed webhook (Stripe and friends) from a JS hook.", href: "/docs/extending/incoming-webhooks/" },
      { name: "Push notifications", body: "Web Push, FCM, and APNs, via _push_subscriptions.", href: "/docs/extending/push-notifications/", code: "_push_subscriptions" },
      { name: "Rust plugins", body: "Extend the server itself without forking it, for the cases a JS hook genuinely can't reach.", href: "/docs/extending/rust-plugins/" },
      { name: "ZIP export", body: "Export a collection's records and files as a ZIP archive.", href: "/docs/extending/zip-export/" },
    ],
  },
  {
    id: "ai",
    title: "AI",
    intro: "Vector search, an LLM chat gateway, and auto-embedding, backed by the same collections and API rules as everything else — not a bolt-on.",
    items: [
      { name: "Vector search", body: "A vector field and nearestTo(...) similarity search over your own collections.", href: "/docs/ai/vector-search/", code: "nearestTo(pb, collection, field, vec, opts)" },
      { name: "Auto-embedding", body: "Write text, get an embedding computed automatically on create/update.", href: "/docs/ai/auto-embedding/" },
      { name: "LLM chat gateway", body: "Stream a chat completion over the realtime connection you already have.", href: "/docs/ai/llm-chat-gateway/", code: "chat(pb, messages, { onDelta })" },
      { name: "MCP server", body: "Runtime tools (call_rpc, send_email, search_nearby) and superuser dev tools (schema, rules, logs, SQL) over MCP.", href: "/docs/ai/mcp-server/", code: "POST /api/mcp" },
    ],
  },
  {
    id: "dashboard",
    title: "Dashboard & operations",
    intro: "Embedded at compile time — cratebase serve is the whole deployment, and every setting is configurable from it.",
    items: [
      { name: "7 tabbed setting groups", body: "Application, Email, Auth & security, Database, Automation, Integrations, and Logs — one page per group.", href: "/docs/dashboard/settings-pages/" },
      { name: "Onboarding checklist", body: "A dismissible walkthrough on the dashboard home: app identity, mail delivery, auth, backups, rate limiting.", href: "/docs/dashboard/tour/" },
      { name: "API docs tab", body: "Every collection's own endpoint reference, generated from its live schema and rules.", href: "/docs/dashboard/api-docs-tab/" },
      { name: "SQL console", body: "A superuser-only console for the query a filter or RPC can't express, right in the dashboard.", href: "/docs/reference/rest-api/sql-console/" },
      { name: "Backups", body: "Streaming backups to local disk or S3, with a documented restore path.", href: "/docs/deploy/backups-restore/" },
      { name: "Metrics", body: "Prometheus exposition, unauthenticated and outside /api by design.", href: "/docs/deploy/metrics/", code: "GET /metrics" },
      { name: "Request logs", body: "Structured request logging to a separate SQLite file, with configurable retention.", href: "/docs/deploy/logs/" },
    ],
  },
  {
    id: "deploy",
    title: "Deploy & portability",
    intro: "SQLite by default; Postgres when you need it. Same API, same filter syntax, same rules, either way.",
    items: [
      { name: "SQLite or Postgres", body: "One environment variable switches backends — no code change, no migration to rewrite.", href: "/docs/deploy/postgres/", code: "DATABASE_URL=postgres://..." },
      { name: "One binary or Docker", body: "The admin dashboard is embedded at compile time; ghcr.io/cratebasehq/cratebase ships multi-arch on every release.", href: "/docs/deploy/docker/" },
      { name: "Horizontal scaling", body: "What's safe to run behind a load balancer, and what LISTEN/NOTIFY buys you on Postgres.", href: "/docs/deploy/horizontal-scaling/" },
      { name: "Security hardening", body: "Rate limiting, the one-time setup token, sandboxed file serving, and security headers — all on by default.", href: "/docs/deploy/security-hardening/" },
      { name: "S3-compatible storage", body: "AWS S3, R2, B2, or self-hosted MinIO/RustFS, configured with three environment variables.", href: "/docs/deploy/s3-storage/" },
      { name: "Reverse proxy & TLS", body: "A documented nginx/Caddy config for terminating TLS in front of cratebase serve.", href: "/docs/deploy/reverse-proxy-tls/" },
      { name: "Configuration reference", body: "Every environment variable, including Postgres/S3/rate-limiting setup.", href: "/docs/deploy/configuration-reference/" },
    ],
  },
];
---

<LandingLayout
  title="Features — Cratebase"
  description="The complete feature list: collections, auth, email, files, realtime, automation, AI, and the admin dashboard — each linking to its docs page."
>
  <section class="wrap section features-head">
    <span class="eyebrow">Features</span>
    <h1>Everything in the binary</h1>
    <p class="lede">
      This is the exhaustive list. For the shape of the product, see the <a href="/">homepage</a>.
      This page exists for the "does it do X" question, grouped so you can scan it in one pass.
    </p>
  </section>

  <nav class="wrap jump-nav" aria-label="Jump to a feature group">
    {groups.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
  </nav>

  {groups.map((group) => (
    <section class="wrap section feature-group" id={group.id}>
      <div class="group-head">
        <h2>{group.title}</h2>
        <p>{group.intro}</p>
      </div>
      <div class="feature-grid">
        {group.items.map((item) => (
          <a class="feature-card" href={item.href}>
            <h3>{item.name}</h3>
            <p>{item.body}</p>
            {item.code && <code class="mono">{item.code}</code>}
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="wrap section final-cta">
    <h2>Didn't find it?</h2>
    <p>The docs cover more than fits a feature grid — or ask in an issue on GitHub.</p>
    <div class="final-cta-actions">
      <a class="btn btn-primary" href="/docs/">Browse the docs</a>
      <a class="btn btn-secondary" href="https://github.com/cratebasehq/cratebase/issues">Open an issue</a>
    </div>
  </section>
</LandingLayout>

<style>
  .features-head {
    padding-block: var(--space-xl) var(--space-md);
  }
  .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-bottom: 0.6rem;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    line-height: 1.03;
    margin: 0 0 1rem;
    color: var(--color-harbor);
  }
  :root[data-theme="dark"] h1 {
    color: var(--color-fog);
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 38rem;
    line-height: 1.55;
  }
  .lede a {
    color: var(--color-ink);
  }

  .jump-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    padding-block: 1rem 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .jump-nav a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }
  .jump-nav a:hover {
    color: var(--color-text);
    border-color: var(--color-ink);
  }

  .feature-group {
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  .group-head {
    max-width: 36rem;
    margin-bottom: var(--space-md);
  }
  .group-head h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
    color: var(--color-harbor);
  }
  :root[data-theme="dark"] .group-head h2 {
    color: var(--color-fog);
  }
  .group-head p {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .feature-card {
    display: block;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    background: var(--color-white);
    transition: border-color 160ms var(--ease-house), transform 160ms var(--ease-house);
  }
  :root[data-theme="dark"] .feature-card {
    background: var(--color-panel);
  }
  .feature-card:hover {
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }
  .feature-card h3 {
    font-family: var(--font-display);
    font-size: 0.98rem;
    margin: 0 0 0.4rem;
  }
  .feature-card p {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }
  .feature-card code {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--color-ink);
  }

  .final-cta {
    text-align: center;
    padding-block: var(--space-2xl) var(--space-3xl);
  }
  .final-cta h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    margin: 0 0 0.6rem;
    color: var(--color-harbor);
  }
  :root[data-theme="dark"] .final-cta h2 {
    color: var(--color-fog);
  }
  .final-cta p {
    color: var(--color-text-secondary);
    margin: 0 0 1.75rem;
  }
  .final-cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
