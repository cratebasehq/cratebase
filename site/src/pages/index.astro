---
import LandingLayout from "../layouts/LandingLayout.astro";
import HeroMedia from "../components/HeroMedia.astro";
import RulePlayground from "../components/RulePlayground.astro";
import TypedFlow from "../components/TypedFlow.astro";
import DashboardTour from "../components/DashboardTour.astro";
import BenchChart from "../components/BenchChart.astro";
import Mark from "../components/Mark.astro";
import LoadedPallet from "../components/illustrations/LoadedPallet.astro";
import Dolly from "../components/illustrations/Dolly.astro";
import HeroUnpack from "../components/illustrations/HeroUnpack.astro";
import CrateStack from "../components/illustrations/CrateStack.astro";

const proof = [
  "One binary, dashboard included",
  "SQLite or Postgres",
  "Works with the official PocketBase SDKs",
  "MIT licensed",
];

// The packing list: one line per capability, each linking to its docs.
// Everything else lives on /features.
const packing = [
  { item: "Auth", line: "Password, email OTP, magic links, TOTP 2FA, 12 OAuth2 presets and generic OIDC.", href: "/docs/concepts/authentication/overview/" },
  { item: "Realtime", line: "Live subscriptions, presence and in-app notifications. Cross-node on Postgres.", href: "/docs/concepts/realtime/" },
  { item: "Files", line: "Local disk or any S3 bucket, presigned uploads, image transforms on the fly.", href: "/docs/concepts/files/" },
  { item: "Search", line: "?search= on any collection. FTS5 on SQLite, tsvector on Postgres.", href: "/docs/database/full-text-search/" },
  { item: "Email", line: "Visual templates your frontend can send with cb.mails.send().", href: "/docs/email/overview/" },
  { item: "SQL", line: "Custom RPC endpoints, geo queries and Postgres extensions.", href: "/docs/database/custom-sql-rpc/" },
  { item: "Hooks", line: "JavaScript hooks, custom routes and cron jobs, hot-reloaded in dev.", href: "/docs/extending/js-hooks/" },
  { item: "Defaults", line: "Rate limits, a one-time setup token and security headers, on from the first run.", href: "/docs/deploy/security-hardening/" },
];
---

<LandingLayout
  title="Cratebase — a backend in one crate"
  description="Collections, auth, files, realtime and an admin dashboard in one self-hostable Rust binary. SQLite today, Postgres when you need it, PocketBase-compatible if you're migrating one in."
>
  <!-- ============================== HERO ============================== -->
  <section class="hero">
    <div class="wrap">
      <a class="announce" href="https://github.com/cratebasehq/cratebase/releases/tag/v0.6.0">
        <span class="announce-dot" aria-hidden="true"></span>
        New in v0.6.0: background jobs, reliable webhooks &amp; <code>bun create cratebase</code>
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
      </a>
      <div class="hero-head">
        <h1><span>A backend in</span> <span>one crate.</span></h1>
        <div class="hero-side">
          <p class="lede">Collections, auth, files and realtime in one self-hostable Rust binary. SQLite today, Postgres when you need it.</p>
          <div class="install-row" role="group" aria-label="Install command">
            <pre class="install-cmd" id="install-command"><code><span class="install-prompt" aria-hidden="true">$ </span>curl -fsSL https://cratebase.dev/install.sh | sh</code></pre>
            <button type="button" class="copy-btn" data-copy="install-command" aria-label="Copy install command">
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.2" />
                <path d="M2.5 10.5v-7A1 1 0 0 1 3.5 2.5h7" />
              </svg>
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/docs/getting-started/install/">Get started</a>
            <a class="btn btn-secondary" href="https://codespaces.new/cratebasehq/cratebase">Open in Codespaces</a>
          </div>
        </div>
      </div>
    </div>
    <div class="wrap wrap-wide hero-stage">
      <HeroMedia />
    </div>
    <ul class="wrap proof" aria-label="At a glance">
      {proof.map((p) => <li><Mark size={14} />{p}</li>)}
    </ul>
  </section>

  <!-- ========================= RULE PLAYGROUND ========================= -->
  <section class="wrap section" id="rules">
    <div class="head head-split">
      <h2>Access rules run inside the&nbsp;query.</h2>
      <p>
        Write one expression per action. Cratebase compiles it into SQL, so a row a user can't see never leaves the database.
        Try it: change the rule, or who's asking.
      </p>
    </div>
    <RulePlayground />
  </section>

  <!-- ======================= SCHEMA → TYPED CLIENT ===================== -->
  <section class="band-dark" id="typed">
    <div class="wrap section">
      <div class="head head-split">
        <h2>From schema to typed client in one command.</h2>
        <p><code>cratebase dev</code> writes the types and keeps them current. No codegen package, no Node toolchain.</p>
        <p>
          Starting from scratch? <code>bun create cratebase</code> scaffolds a whole app — Next.js, Vite + React, or
          Expo — already wired up to it. <a href="/docs/getting-started/starter-kits/">See starter kits →</a>
        </p>
      </div>
      <TypedFlow />
    </div>
  </section>

  <!-- ============================ PACKING LIST ========================== -->
  <section class="wrap section" id="inside">
    <div class="label">
      <div class="label-head">
        <div>
          <h2>Everything else is already in the crate.</h2>
          <p>No second vendor for mail, storage, search or auth.</p>
        </div>
        <div class="label-stamp" aria-hidden="true"><CrateStack /></div>
      </div>
      <ul class="packing">
        {
          packing.map((p) => (
            <li>
              <a href={p.href}>
                <span class="packing-item">{p.item}</span>
                <span class="packing-line">{p.line}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="label-foot" href="/features/">See every feature</a>
    </div>
  </section>

  <!-- ========================= DASHBOARD TOUR =========================== -->
  <section class="wrap section" id="dashboard">
    <div class="head head-split">
      <h2>A dashboard for every setting.</h2>
      <p>Embedded in the binary. Real screens from a running instance.</p>
    </div>
    <DashboardTour />
  </section>

  <!-- ========================== PERFORMANCE ============================ -->
  <section class="band-paper" id="performance">
    <div class="wrap section perf">
      <div class="perf-head">
        <h2>10× PocketBase's search throughput, on the same machine.</h2>
        <p>22 of 24 benchmark cells faster in the latest idle-host run, measured over HTTP, back to back.</p>
        <a class="more" href="/docs/benchmarks/">Methodology and every result</a>
        <div class="perf-art"><LoadedPallet label="A pallet stacked with crates, moving fast" /></div>
      </div>
      <div class="perf-chart">
        <BenchChart />
      </div>
    </div>
  </section>

  <!-- ======================= MOVING FROM POCKETBASE ==================== -->
  <section class="wrap section migrate">
    <div class="migrate-art"><Dolly label="A hand truck carrying two crates: the migration tool" /></div>
    <div class="migrate-copy">
      <h2>Coming from PocketBase? Your SDK already works.</h2>
      <p>Same wire protocol: 180 of 181 conformance tests pass against the official SDK. Your data moves in one command, and passwords keep working.</p>
      <a class="more" href="/docs/migrating/compatibility/">Migration guide</a>
    </div>
    <pre class="migrate-code"><code><span class="p">$</span> cratebase migrate-from-pocketbase pb_data \
    --dir cratebase_data

<span class="del">- new PocketBase("https://pocketbase.example.com")</span>
<span class="add">+ new PocketBase("https://cratebase.example.com")</span></code></pre>
  </section>

  <!-- ============================= FINAL CTA ============================ -->
  <section class="wrap final">
    <div class="final-art" aria-hidden="true"><HeroUnpack /></div>
    <h2>Ship the next one in one binary.</h2>
    <div class="final-actions">
      <a class="btn btn-primary btn-lg" href="/docs/getting-started/install/">Get started</a>
      <a class="btn btn-secondary btn-lg" href="https://github.com/cratebasehq/cratebase">View on GitHub</a>
    </div>
    <p class="final-note">MIT licensed. Self-host it, fork it, ship it.</p>
  </section>
</LandingLayout>

<style>
  /* ---------------- shared ---------------- */
  .wrap-wide {
    max-width: 82rem;
  }
  .section {
    padding-block: clamp(3.25rem, 5.5vw, 4.75rem);
  }
  .head {
    max-width: 42rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .head h2,
  .label h2,
  .perf-head h2,
  .migrate h2,
  .final h2 {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--text-3xl);
    line-height: 1.02;
    letter-spacing: -0.028em;
    margin: 0 0 1rem;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .head p,
  .label-head p,
  .perf-head p,
  .migrate p {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 36rem;
    text-wrap: pretty;
  }
  .head-split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2rem 4rem;
    align-items: end;
    max-width: none;
  }
  .head-split h2 {
    margin: 0;
  }
  .head-split p {
    font-size: var(--text-base);
  }
  .head-center {
    text-align: center;
    margin-inline: auto;
    max-width: 52rem;
  }
  .head-center p {
    margin-inline: auto;
    max-width: 44rem;
  }
  .more {
    display: inline-block;
    margin-top: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    text-underline-offset: 0.25em;
  }
  code {
    font-size: 0.92em;
  }

  /* ---------------- hero ---------------- */
  .hero {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .announce {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.8rem 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-panel);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      border-color 160ms var(--ease-house),
      color 160ms var(--ease-house);
  }
  .announce:hover {
    border-color: var(--color-ink);
    color: var(--color-text);
  }
  .announce:focus-visible {
    outline: 2px solid var(--color-crate);
    outline-offset: 2px;
  }
  .announce-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-crate);
    flex-shrink: 0;
  }
  .hero-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 25rem);
    gap: 2rem clamp(2rem, 4vw, 4rem);
    align-items: end;
    margin-top: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.8rem, 0.9rem + 6.2vw, 6.2rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    margin: 0;
    color: var(--color-ink);
  }
  h1 span {
    display: block;
    white-space: nowrap;
  }
  .lede {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem;
    max-width: 30rem;
  }
  .install-row {
    display: flex;
    align-items: stretch;
    min-width: 0;
    margin-bottom: 1rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-harbor);
  }
  :root[data-theme="dark"] .install-row {
    background: #06101a;
    box-shadow: inset 0 0 0 1px var(--color-border);
  }
  .install-cmd {
    margin: 0;
    padding: 0.85rem 1rem;
    color: #eef1f4;
    font-size: 0.86rem;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .install-prompt {
    color: var(--color-crate);
    user-select: none;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0 1rem;
    background: rgba(255, 255, 255, 0.06);
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    color: #eef1f4;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    cursor: pointer;
    transition: background 140ms var(--ease-house);
  }
  .copy-btn:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .copy-btn:focus-visible {
    outline: 2px solid var(--color-crate);
    outline-offset: -2px;
  }
  .copy-btn.is-copied {
    color: #ffbe93;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .proof {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2.5rem;
    margin: 0 auto;
    padding-block: 2rem 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .proof li :global(svg) {
    color: var(--color-crate);
  }

  /* ---------------- typed band ---------------- */
  .band-dark {
    background:
      radial-gradient(50% 60% at 80% 0%, rgba(88, 132, 180, 0.22), transparent 70%),
      var(--color-harbor);
    color: #eef1f4;
  }
  :root[data-theme="dark"] .band-dark {
    background:
      radial-gradient(50% 60% at 80% 0%, rgba(88, 132, 180, 0.14), transparent 70%),
      #0c1c2e;
    box-shadow:
      inset 0 1px 0 var(--color-border),
      inset 0 -1px 0 var(--color-border);
  }
  .band-dark .head h2 {
    color: #eef1f4;
  }
  .band-dark .head p {
    color: #b3c1cf;
  }

  /* ---------------- packing list ---------------- */
  .label {
    position: relative;
    border: 1.5px solid var(--color-ink);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--color-panel);
  }
  .label-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: start;
    padding-bottom: clamp(1rem, 2.5vw, 1.5rem);
    border-bottom: 1.5px dashed var(--color-ink);
  }
  .label-head h2 {
    max-width: 38rem;
  }
  .label-stamp {
    width: clamp(4.5rem, 9vw, 7.5rem);
  }
  .packing {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 4vw, 3.5rem);
  }
  .packing li {
    border-bottom: 1px solid var(--color-border);
  }
  .packing a {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem 0;
    text-decoration: none;
    color: inherit;
  }
  .packing a:hover .packing-line {
    color: var(--color-text);
  }
  .packing a:hover .packing-item {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .packing a:focus-visible {
    outline: 2px solid var(--color-crate);
    outline-offset: 2px;
  }
  .packing-item {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-ink);
  }
  .packing-line {
    color: var(--color-text-secondary);
    line-height: 1.5;
    transition: color 160ms var(--ease-house);
  }
  .label-foot {
    display: inline-block;
    margin-top: 1.5rem;
    font-weight: 600;
    color: var(--color-ink);
    text-underline-offset: 0.25em;
  }

  /* ---------------- performance ---------------- */
  .band-paper {
    background: var(--color-white);
    border-block: 1px solid var(--color-hairline);
  }
  :root[data-theme="dark"] .band-paper {
    background: var(--color-panel);
    border-color: var(--color-border);
  }
  .perf {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .perf-head h2 {
    font-size: var(--text-2xl);
  }
  .perf-head p {
    font-size: var(--text-base);
  }
  .perf-art {
    width: min(15rem, 60%);
    margin-top: clamp(1.5rem, 4vw, 3rem);
  }

  /* ---------------- migrate ---------------- */
  .migrate {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .migrate-art {
    width: 100%;
  }
  .migrate h2 {
    font-size: var(--text-2xl);
  }
  .migrate p {
    font-size: var(--text-base);
  }
  .migrate-code {
    margin: 0;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--color-harbor);
    color: #eef1f4;
    font-size: 0.82rem;
    line-height: 1.8;
    overflow-x: auto;
  }
  :root[data-theme="dark"] .migrate-code {
    background: #06101a;
    box-shadow: inset 0 0 0 1px var(--color-border);
  }
  .migrate-code .p {
    color: var(--color-crate);
  }
  .migrate-code .del {
    color: #ffaaa6;
  }
  .migrate-code .add {
    color: #9ed9b5;
  }

  /* ---------------- final ---------------- */
  .final {
    text-align: center;
    padding-block: clamp(1rem, 3vw, 2rem) clamp(4rem, 7vw, 5.5rem);
  }
  .final-art {
    width: min(12.5rem, 55%);
    margin: 0 auto 1.25rem;
  }
  .final h2 {
    font-size: var(--text-4xl);
    margin-bottom: 1.75rem;
  }
  .final-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn-lg {
    padding: 0.8rem 1.4rem;
    font-size: 1rem;
  }
  .final-note {
    margin: 1.25rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  /* ---------------- responsive ---------------- */
  @media (max-width: 1000px) {
    .hero-head,
    .head-split,
    .perf {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-head {
      align-items: start;
    }
    .perf-art {
      display: none;
    }
    .migrate {
      grid-template-columns: 6rem minmax(0, 1fr);
    }
    .migrate-code {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 760px) {
    .packing {
      grid-template-columns: 1fr;
    }
    .packing a {
      grid-template-columns: 1fr;
      gap: 0.2rem;
      padding: 0.9rem 0;
    }
    .migrate {
      grid-template-columns: minmax(0, 1fr);
    }
    .migrate-art {
      width: 5.5rem;
    }
    .proof {
      justify-content: flex-start;
      gap: 0.6rem 1.5rem;
    }
    .label-stamp {
      width: 3.5rem;
    }
  }
</style>
