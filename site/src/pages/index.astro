---
import LandingLayout from "../layouts/LandingLayout.astro";
import HeroMedia from "../components/HeroMedia.astro";
import CodeTabs from "../components/CodeTabs.astro";
import DeviceFrame from "../components/DeviceFrame.astro";
import BenchChart from "../components/BenchChart.astro";
import CrateSignal from "../components/illustrations/CrateSignal.astro";
import Warehouses from "../components/illustrations/Warehouses.astro";
import Dolly from "../components/illustrations/Dolly.astro";
import CrateLocked from "../components/illustrations/CrateLocked.astro";

import dashboardHomeLight from "../assets/dashboard/light/01-dashboard-home.png";
import dashboardHomeDark from "../assets/dashboard/dark/01-dashboard-home.png";
import authOptionsLight from "../assets/dashboard/light/06-users-auth-options.png";
import authOptionsDark from "../assets/dashboard/dark/06-users-auth-options.png";
import schemaRulesLight from "../assets/dashboard/light/03-collections-places-schema-rules.png";
import schemaRulesDark from "../assets/dashboard/dark/03-collections-places-schema-rules.png";
import templateEditorLight from "../assets/dashboard/light/08-settings-email-template-editor.png";
import templateEditorDark from "../assets/dashboard/dark/08-settings-email-template-editor.png";
import settingsIndexLight from "../assets/dashboard/light/05-settings-index.png";
import settingsIndexDark from "../assets/dashboard/dark/05-settings-index.png";
import emailTemplatesLight from "../assets/dashboard/light/07-settings-email-templates.png";
import emailTemplatesDark from "../assets/dashboard/dark/07-settings-email-templates.png";
import rpcLight from "../assets/dashboard/light/09-settings-rpc.png";
import rpcDark from "../assets/dashboard/dark/09-settings-rpc.png";
import recordsSearchLight from "../assets/dashboard/light/11-collections-posts-records-search.png";
import recordsSearchDark from "../assets/dashboard/dark/11-collections-posts-records-search.png";

const zeroToBackendSteps = [
  {
    n: "01",
    title: "Start the dev server",
    body: "One command provisions a superuser, seeds pb_seed/, writes types, and starts listening — no setup form to click through.",
    tabs: [
      { label: "Local", code: `$ curl -fsSL https://cratebase.dev/install.sh | sh\n$ cratebase dev\n\nsuperuser: admin@localhost / a1B2c3D4...\ndashboard: http://127.0.0.1:8090/_/\napi:       http://127.0.0.1:8090/api/` },
      { label: "Docker", code: `$ docker run -p 8090:8090 -v cratebase_data:/app/data \\\n    ghcr.io/cratebasehq/cratebase:latest` },
    ],
  },
  {
    n: "02",
    title: "Define a collection",
    body: "From the dashboard, or check a schema.json into your repo and push it — a dry run flags anything destructive before it touches data.",
    tabs: [
      { label: "CLI", code: `$ cratebase schema push schema.json --dry-run\n\n+ posts (new)\n    title      text, required, searchable\n    published  bool\n    author     relation -> users` },
    ],
  },
  {
    n: "03",
    title: "Generate types from it",
    body: "Typegen ships in the binary — no separate package, no Node toolchain. An unknown collection name becomes a compile error, not a 404 in production.",
    tabs: [
      { label: "One-off", code: `$ cratebase typegen -o cratebase-types.d.ts` },
      { label: "Watch mode", code: `$ cratebase dev --typegen-watch\n\n# rewrites cratebase-types.d.ts on every schema change` },
    ],
  },
  {
    n: "04",
    title: "Wire it into your app, live",
    body: "useRecords fetches the list once, then keeps it current — a write from any client lands here with no refresh and no polling.",
    tabs: [
      { label: "React", code: `import { useRecords } from "@cratebase/react";\nimport { cb } from "./cratebase";\n\nfunction PostList() {\n  const { records: posts } = useRecords(cb, "posts", { sort: "-created" });\n  return posts.map((p) => &lt;Post key={p.id} post={p} /&gt;);\n}` },
      { label: "Vanilla TS", code: `import { createClient } from "@cratebase/client";\n\nconst cb = createClient("http://localhost:8090");\nconst posts = await cb.collection("posts").list({ sort: "-created" });\ncb.collection("posts").subscribe("*", (e) => render(e.record));` },
    ],
  },
];

const pillars = [
  {
    id: "auth",
    eyebrow: "Auth",
    title: "Sign-in your users will actually use",
    body: "Password, email OTP, magic link, TOTP 2FA with backup codes, and twelve OAuth2 presets plus generic OIDC — all on the same session model, none of it hand-rolled.",
    bullets: [
      "Google, Apple, GitHub, Microsoft, Discord, GitLab, Facebook, X, LinkedIn, Slack, Twitch, Spotify — built in, plus a generic OIDC issuer for anything else.",
      "Email OTP and magic-link sign-in ship as no-code toggles, not custom flows to build and maintain.",
      "TOTP 2FA layers onto any first factor — password, OTP, magic link, or OAuth — with backup codes issued once.",
      "New-location login alerts and superuser impersonation are already wired in, not a feature you build later.",
    ],
    code: `const { secret, uri } = await cb.auth.totp.setup();
// uri -> render as a QR code; user scans it in their app

const { backupCodes } = await cb.auth.totp.confirm(codeFromApp);
// show these 10 codes once -- hashed server-side, never shown again

await cb.collection("users").requestMagicLink({ email });
// -> POST .../auth-with-magic-link on click, no password involved`,
    visual: { light: authOptionsLight, dark: authOptionsDark, path: "localhost:8090/_/collections/users?tab=schema", alt: "The users collection's Auth options panel in the Cratebase dashboard, showing OAuth2 providers and sign-in methods." },
    href: "/docs/concepts/authentication/overview/",
  },
  {
    id: "data",
    eyebrow: "Data",
    title: "Rules enforced in SQL, not in code you have to trust",
    body: "A small filter-expression language compiles straight into the query plan — list/view/create/update/delete access lives next to the schema, not scattered across route handlers.",
    bullets: [
      "API rules (owner = @request.auth.id) enforced in SQL for every list/view/create/update/delete call.",
      "Full-text search (?search=) on any collection — SQLite FTS5 or Postgres tsvector, kept in sync automatically.",
      "Custom SQL RPC (cb.rpc(name, params)) for the GROUP BY, window function, or PostGIS query a filter can't express.",
      "sort=geoDistance(...) nearest-first queries, GiST-indexed automatically once PostGIS is installed.",
      "Realtime subscriptions over SSE — cross-node on Postgres via LISTEN/NOTIFY — plus presence and in-app notifications.",
    ],
    code: `// API rule, enforced in SQL on every request:
updateRule: "owner = @request.auth.id"

// nearest 5 open stores within 10km, PostGIS-accelerated:
GET /api/collections/stores/records
  ?filter=geoDistance(loc.lon,loc.lat,-122.42,37.77)<10 && open=true
  &sort=geoDistance(loc.lon,loc.lat,-122.42,37.77)
  &perPage=5`,
    visual: { light: schemaRulesLight, dark: schemaRulesDark, path: "localhost:8090/_/collections/places?tab=schema", alt: "A collection's schema and API rules editor in the Cratebase dashboard." },
    href: "/docs/concepts/api-rules/",
  },
  {
    id: "email-files",
    eyebrow: "Email & files",
    title: "Send mail and store files without a second vendor",
    body: "A visual template editor, a send API your frontend can call directly, and file storage that moves from local disk to S3 with three environment variables.",
    bullets: [
      "Templates use {{variables}}, layouts, and locales, edited in a full visual builder — not an HTML textarea.",
      "cb.mails.send(...) is callable from a signed-in (or anonymous) app user when a template's sendRule allows it — transactional mail with no backend of its own.",
      "No-code triggers fire a template on a record create/update/delete; every send is logged to the mail log.",
      "Presigned direct uploads (cb.files.upload) skip the multipart round trip; local disk or any S3-compatible bucket, one driver swap.",
      "Image transforms (?w=&h=&fit=&format=) on the files route, independent of the existing thumbnail sizes.",
    ],
    code: `// callable from the frontend -- no backend of its own:
await cb.mails.send({
  to: recipientEmail,
  template: "invite",
  data: { invitedBy: currentUser.name, teamName: "Acme" },
});

const upload = await cb.files.upload(file, { collection: "posts", field: "cover" });
await cb.collection("posts").create({ id: upload.recordId, title, cover: upload.token });`,
    visual: { light: templateEditorLight, dark: templateEditorDark, path: "localhost:8090/_/settings/email-templates/welcome", alt: "The visual email template editor in the Cratebase dashboard, with a live preview." },
    href: "/docs/email/overview/",
  },
];

const dashboardShots = [
  { light: dashboardHomeLight, dark: dashboardHomeDark, alt: "Cratebase dashboard home, with the onboarding checklist guiding a fresh install through app identity, mail delivery, auth, backups, and rate limiting.", path: "localhost:8090/_/", caption: "Onboarding checklist", href: "/docs/dashboard/tour/" },
  { light: settingsIndexLight, dark: settingsIndexDark, alt: "Cratebase settings, consolidated into seven tabbed groups.", path: "localhost:8090/_/settings", caption: "Every setting, 7 tabbed groups", href: "/docs/dashboard/settings-pages/" },
  { light: emailTemplatesLight, dark: emailTemplatesDark, alt: "The list of email templates in the Cratebase dashboard.", path: "localhost:8090/_/settings/email?tab=templates", caption: "Email templates", href: "/docs/email/templates/" },
  { light: rpcLight, dark: rpcDark, alt: "The RPC functions screen in the Cratebase dashboard, defining a named SQL endpoint.", path: "localhost:8090/_/settings/rpc", caption: "Custom SQL RPC", href: "/docs/database/custom-sql-rpc/" },
  { light: recordsSearchLight, dark: recordsSearchDark, alt: "A collection's records list in the Cratebase dashboard, with full-text search.", path: "localhost:8090/_/collections/posts", caption: "Records + full-text search", href: "/docs/database/full-text-search/" },
];
---

<LandingLayout
  title="Cratebase — a backend in one crate"
  description="Collections, auth, files, realtime and an admin dashboard in one self-hostable Rust binary. SQLite today, Postgres when you need it, PocketBase-compatible if you're migrating one in."
>
  <!-- ============================== HERO ============================== -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <a class="announce" href="https://github.com/cratebasehq/cratebase/releases/tag/v0.4.0">
          <span class="announce-dot" aria-hidden="true"></span>
          New in v0.4.0: email platform, custom SQL RPC &amp; TOTP 2FA
        </a>
        <h1>A backend in one crate.</h1>
        <p class="lede">Collections, auth, files, and realtime — one self-hostable Rust binary, SQLite today, Postgres when you need it.</p>

        <div class="install-row" role="group" aria-label="Install command">
          <pre class="install-cmd mono" id="install-command"><code>curl -fsSL https://cratebase.dev/install.sh | sh</code></pre>
          <button type="button" class="copy-btn" data-copy="install-command" aria-label="Copy install command">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <rect x="5.5" y="5.5" width="8" height="8" rx="1.2" />
              <path d="M2.5 10.5v-7A1 1 0 0 1 3.5 2.5h7" />
            </svg>
            <span class="copy-label">Copy</span>
          </button>
        </div>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/docs/getting-started/install/">Get started</a>
          <a class="btn btn-secondary" href="https://codespaces.new/cratebasehq/cratebase">Open in GitHub Codespaces</a>
        </div>
      </div>
      <div class="hero-art" data-reveal>
        <HeroMedia
          fallbackLight={dashboardHomeLight}
          fallbackDark={dashboardHomeDark}
          fallbackAlt="The Cratebase admin dashboard home screen, running locally."
        />
      </div>
    </div>
  </section>

  <!-- ===================== ZERO TO TYPED BACKEND ======================= -->
  <section class="wrap section" id="zero-to-backend">
    <div class="section-head" data-reveal>
      <span class="eyebrow">From zero to backend</span>
      <h2>Thirty seconds, start to typed client</h2>
      <p>Define a collection's shape once, and everything downstream — generated types, the typed client, your React components — stays in sync with it.</p>
    </div>
    <ol class="steps">
      {zeroToBackendSteps.map((step, i) => (
        <li data-reveal data-reveal-group="steps" data-reveal-index={i}>
          <span class="step-n mono">{step.n}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
          <CodeTabs groupId={`step-${step.n}`} tabs={step.tabs} />
        </li>
      ))}
    </ol>
  </section>

  <!-- ============================= PILLARS ============================= -->
  {pillars.map((pillar, i) => (
    <section class={`wrap section pillar ${i % 2 === 1 ? "pillar-reverse" : ""}`} id={pillar.id}>
      <div class="pillar-copy" data-reveal>
        <span class="eyebrow">{pillar.eyebrow}</span>
        <h2>{pillar.title}</h2>
        <p class="pillar-body">{pillar.body}</p>
        <pre class="pillar-code mono"><code set:html={pillar.code} /></pre>
        <ul class="pillar-bullets">
          {pillar.bullets.map((b) => <li>{b}</li>)}
        </ul>
        <a class="pillar-link" href={pillar.href}>Read the docs →</a>
      </div>
      <div class="pillar-visual" data-reveal data-parallax data-parallax-strength="0.035">
        <DeviceFrame light={pillar.visual.light} dark={pillar.visual.dark} alt={pillar.visual.alt} path={pillar.visual.path} />
      </div>
    </section>
  ))}

  <!-- ==================== PERFORMANCE & PORTABILITY ==================== -->
  <section class="band">
    <div class="wrap section">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Performance &amp; portability</span>
        <h2>Fast by default, portable by design</h2>
        <p>22 of 24 benchmark cells were faster on Cratebase in the latest idle-host run, several by an order of magnitude — measured HTTP-level, back to back, on the same machine.</p>
      </div>

      <div class="perf-panel" data-reveal>
        <BenchChart />
        <p class="footnote">
          The <code>auth</code> win (not charted above) is a security-parameter difference — Argon2id vs. PocketBase's bcrypt cost-12 — not throughput work.
          <a href="/docs/benchmarks/">Full methodology, caveats, and results →</a>
        </p>
      </div>

      <div class="portability-grid">
        <div class="portability-card" data-reveal data-reveal-group="port" data-reveal-index="0">
          <div class="portability-art"><Warehouses label="Two warehouses sharing one rail, a crate crossing between them" /></div>
          <h3>SQLite or Postgres, zero code change</h3>
          <p>Same API, same filter syntax, same rules — switch with one environment variable:</p>
          <div class="diff-blocks">
            <pre class="mono"><code>DATABASE_URL=sqlite://./data.db</code></pre>
            <pre class="mono"><code>DATABASE_URL=postgres://user:pass@host/db</code></pre>
          </div>
          <p class="small">On Postgres, realtime becomes cross-node via <code>LISTEN</code>/<code>NOTIFY</code> — a write on one instance reaches a subscriber on another in ~95&ndash;100ms measured, HTTP-in to SSE-out.</p>
        </div>
        <div class="portability-card" data-reveal data-reveal-group="port" data-reveal-index="1">
          <div class="portability-art"><CrateSignal label="A crate broadcasting to listening terminals" /></div>
          <h3>One binary, everywhere</h3>
          <p>The admin dashboard is embedded at compile time — deploying is copying one file, or running one Docker image:</p>
          <pre class="mono"><code>docker run -p 8090:8090 -v cratebase_data:/app/data \
  ghcr.io/cratebasehq/cratebase:latest</code></pre>
          <p class="small">No Rust toolchain, no build step, and no separate auth service, database, or object store to stand up first.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= MOVING FROM POCKETBASE ==================== -->
  <section class="wrap section">
    <div class="migrate-panel">
      <div class="migrate-art" data-reveal data-parallax data-parallax-strength="0.04"><Dolly label="A hand truck carrying two crates: the migration tool" /></div>
      <div data-reveal>
        <span class="eyebrow">Compatibility</span>
        <h2>Moving from PocketBase</h2>
        <p>
          Cratebase speaks the same wire protocol: the official <code>pocketbase</code>
          JS/TS client (and PocketBase's other official SDKs) work against it unchanged —
          verified against the real SDK, 180 of 181 conformance tests pass. Already running
          PocketBase? Bring your data over in one command:
        </p>
        <pre class="mono"><code>cratebase migrate-from-pocketbase pb_data --dir cratebase_data</code></pre>
        <pre class="mono report"><code>{`collections created: 2
  + categories
  + books
collections updated (existing schema, fields merged): 1
  ~ users
records migrated:
  _superusers: 1
  books: 3
  categories: 2
  users: 1
files copied: 4`}</code></pre>
        <ul class="checklist">
          <li>Passwords keep working — bcrypt hashes verify directly, re-hashed to Argon2id on next login.</li>
          <li>Collection and record ids are preserved (deterministic id derivation, verified identical to PocketBase's own).</li>
          <li>Not migrated: sessions, OAuth2 secrets, <code>_mfas</code>/<code>_otps</code>/<code>_externalAuths</code>/<code>_authOrigins</code>, <code>pb_hooks</code>.</li>
        </ul>
        <pre class="mono diff"><code>{`- const pb = new PocketBase("https://pocketbase.example.com");
+ const pb = new PocketBase("https://cratebase.example.com");`}</code></pre>
        <a class="pillar-link" href="/docs/migrating/compatibility/">Read the full migration guide →</a>
      </div>
    </div>
  </section>

  <!-- ========================= DASHBOARD SHOWCASE ======================= -->
  <section class="band">
    <div class="wrap section">
      <div class="section-head" data-reveal>
        <span class="eyebrow">The dashboard</span>
        <h2>Every setting configurable, nothing left to the API</h2>
        <p>Settings organized into seven tabbed groups, a visual email builder, a SQL/RPC console, and an onboarding checklist that walks a fresh install through the parts that matter — all real screens from a running instance.</p>
      </div>
      <div class="shot-grid">
        {dashboardShots.map((shot, i) => (
          <a class="shot-card" href={shot.href} data-reveal data-reveal-group="shots" data-reveal-index={i}>
            <DeviceFrame light={shot.light} dark={shot.dark} alt={shot.alt} path={shot.path} widths={[360, 560, 760]} sizes="(min-width: 900px) 30vw, 90vw" />
            <span class="shot-caption">{shot.caption}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== PRODUCTION DEFAULTS =========================== -->
  <section class="wrap section">
    <div class="prod-panel">
      <div class="prod-art" data-reveal><CrateLocked label="A crate with a padlock: security defaults" /></div>
      <div data-reveal>
        <span class="eyebrow">Production defaults</span>
        <h2>Not opt-ins — the default the day you run <code>cratebase serve</code></h2>
        <ul class="checklist">
          <li>Rate limiting is on out of the box — auth, create, and batch endpoints each get their own limit before you've configured anything.</li>
          <li>A fresh instance can't be claimed by whoever finds the port first: the one-time setup URL's token is what turns "found this instance" into "owns it."</li>
          <li>File serving is sandboxed to the configured storage root — no request path can walk outside it.</li>
          <li>Standard security headers ship on every response.</li>
          <li>Streaming backups, to local disk or S3 — <code>VACUUM INTO</code> on SQLite, the real <code>pg_dump</code>/<code>pg_restore</code> on Postgres.</li>
        </ul>
        <a class="pillar-link" href="/docs/deploy/security-hardening/">Security hardening →</a>
      </div>
    </div>
  </section>

  <!-- ============================= FINAL CTA ============================ -->
  <section class="wrap section final-cta" data-reveal>
    <h2>Ship the next one in one binary.</h2>
    <p>Install it, read the docs, or open it in a browser right now.</p>
    <div class="final-cta-actions">
      <a class="btn btn-primary" href="/docs/">Read the docs</a>
      <a class="btn btn-secondary" href="https://codespaces.new/cratebasehq/cratebase">Open in GitHub Codespaces</a>
      <a class="btn btn-secondary" href="https://github.com/cratebasehq/cratebase">View on GitHub</a>
    </div>
    <p class="license-note">MIT licensed. Self-host it, fork it, ship it.</p>
  </section>
</LandingLayout>

<style>
  .hero {
    padding-block: 3rem 4.5rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  .announce {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    margin-bottom: 1.4rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    background: var(--color-white);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: border-color 160ms var(--ease-house), color 160ms var(--ease-house);
  }
  .announce:hover {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }
  :root[data-theme="dark"] .announce {
    background: var(--color-panel);
  }
  .announce-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-crate);
    flex-shrink: 0;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-4xl);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0 0 1.1rem;
    color: var(--color-harbor);
  }
  :root[data-theme="dark"] h1 {
    color: var(--color-fog);
  }
  .lede {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 34rem;
    margin: 0 0 2rem;
  }

  .install-row {
    display: flex;
    align-items: stretch;
    max-width: 30rem;
    min-width: 0;
    margin-bottom: 1.75rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-harbor);
  }
  :root[data-theme="dark"] .install-row {
    box-shadow: inset 0 0 0 1px rgba(238, 241, 244, 0.1);
  }
  .install-cmd {
    margin: 0;
    padding: 0.85rem 1.1rem;
    color: #eef1f4;
    font-size: 0.88rem;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0 1rem;
    background: rgba(255, 255, 255, 0.06);
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    color: #eef1f4;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    cursor: pointer;
    transition: background 140ms var(--ease-house);
  }
  .copy-btn:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .copy-btn.is-copied {
    color: #ffbe93;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .band {
    background: var(--color-fog);
  }
  :root[data-theme="dark"] .band {
    background: #0d1c2b;
  }
  .section {
    padding-block: var(--space-2xl);
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-bottom: 0.6rem;
  }
  .section-head {
    max-width: 40rem;
    margin-bottom: var(--space-xl);
  }
  .section-head h2,
  .pillar-copy h2,
  .migrate-panel h2,
  .prod-panel h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-2xl);
    letter-spacing: -0.015em;
    line-height: 1.1;
    margin: 0 0 0.9rem;
    color: var(--color-harbor);
  }
  :root[data-theme="dark"] .section-head h2,
  :root[data-theme="dark"] .pillar-copy h2,
  :root[data-theme="dark"] .migrate-panel h2,
  :root[data-theme="dark"] .prod-panel h2 {
    color: var(--color-fog);
  }
