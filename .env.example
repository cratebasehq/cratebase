# Copy to `.env` and adjust. Every variable has a working default — none
# of this is required to run `cratebase serve` locally.
#
# This file documents exactly the env vars Cratebase reads — no more, no
# less. `crates/server/src/config.rs`'s `KNOWN_ENV_VARS` list is the
# source of truth and `crates/server/tests/env_example.rs` fails the
# build if the two ever drift apart, so treat both as authoritative over
# any other doc (including this comment) if they disagree.

# --- server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8090
# Comma-separated list, or `*` for any origin (default).
CORS_ALLOW_ORIGINS=*
# Persist every /api/* request to the dashboard's Logs page (default
# true). On SQLite the log lives in a separate <db>.logs.db file so it
# never contends with user traffic.
# LOG_REQUESTS=true
# JS hooks/migrations directories, PocketBase-style. Default: siblings of
# CRATEBASE_DATA_DIR (`pb_hooks`/`pb_migrations`, or `<dir>/../pb_hooks`
# when CRATEBASE_DATA_DIR itself is set).
# CB_HOOKS_DIR=./pb_hooks
# CB_MIGRATIONS_DIR=./pb_migrations

# --- database -----------------------------------------------------------
# Default: sqlite next to the binary. Swap to Postgres for horizontal
# scale/multi-instance deployments — same schema, same API, zero code
# changes.
#   DATABASE_URL=postgres://cratebase:cratebase@localhost:5432/cratebase
# A managed provider that requires TLS (Neon, Supabase, RDS, ...) just
# needs `?sslmode=` on the URL: `require`, `verify-ca` and `verify-full`
# are supported alongside libpq's own `disable`/`allow`/`prefer`.
#   DATABASE_URL=postgres://user:pass@host/db?sslmode=verify-full
DATABASE_URL=sqlite://./data/cratebase.db
CRATEBASE_DATA_DIR=./data
# SQLite reader pool size. Defaults to one per CPU core, clamped to
# 4..16. No effect on Postgres.
# DATABASE_MAX_CONNECTIONS=8
# Postgres connection pool size (default: 10). No effect on SQLite, which
# uses DATABASE_MAX_CONNECTIONS above instead.
# DB_POOL_SIZE=10

# --- auth & sessions ---------------------------------------------------------
# HMAC secret for signing session tokens. Leave unset locally: a random
# secret is generated once and persisted to `<CRATEBASE_DATA_DIR>/.secret`.
# Set this explicitly in production (e.g. multi-instance deployments where
# every instance must share the same secret). `CB_SECRET` is an alias
# checked first.
AUTH_SECRET=
# 32-char key that encrypts `_params` values (stored SMTP/S3 credentials,
# etc.) at rest with AES-256-GCM. Must be exactly 32 characters — any
# other length is ignored (with a warning) and values are stored in
# plaintext instead of failing the boot.
# CB_ENCRYPTION=
# Per-IP rate limit on the login endpoints (auth-with-password) — blunts
# credential-stuffing/brute-force attempts. On by default; turn off only
# if you're already rate-limiting at a reverse proxy in front of
# Cratebase.
AUTH_RATE_LIMIT_ENABLED=true
# First-run install token for `POST /api/setup` (creating the first
# superuser). Unset: a random one is generated at boot and printed in the
# log as a ready-to-open dashboard link. Set it for scripted deploys.
# CB_SETUP_TOKEN=
# Whether logins write a `_sessions` row (default true) so it can later
# be listed/revoked. Stateless auth verification never depends on this.
# SESSION_TRACKING=true
# Also accept/set an httpOnly session cookie alongside the bearer token
# (default false). Turning this on also enables CORS `allow_credentials`,
# so CORS_ALLOW_ORIGINS must then be an explicit origin list — the server
# refuses to boot with the default `*` and cookies both enabled.
# SESSION_COOKIE=false
# SESSION_COOKIE_NAME=cb_session
# Empty (default) means host-only: no `Domain` attribute at all.
# SESSION_COOKIE_DOMAIN=
# Lax (default), Strict, or None (case-insensitive).
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=true

# --- oauth2 -----------------------------------------------------------------
# OAuth2 (Google, GitHub, or a hand-configured custom provider) is
# configured per auth collection, not here: enable it and add a
# provider's client id/secret from the dashboard's collection editor
# ("Authentication" > "OAuth2"), or via `_collections`' `options.oauth2`
# through the API. "google"/"github" only need a client id and secret;
# their endpoints are built in.

# --- file storage: S3 --------------------------------------------------------
# Local disk (`<CRATEBASE_DATA_DIR>/storage`) is the default; nothing
# below is required. These seed the dashboard's Settings > Files S3
# config on FIRST BOOT ONLY — i.e. only while `_params` has no settings
# row yet. Once a database has settings (any boot after the first),
# these env vars are ignored; edit S3 config from the dashboard or
# `PATCH /api/settings` instead, so an operator's change there can't be
# clobbered by a stale `.env`. Works with AWS S3 and any S3-compatible
# service — RustFS/MinIO for self-hosted dev or prod, Cloudflare R2,
# Backblaze B2, etc. — just point S3_ENDPOINT at it.
# S3_ENABLED=true
# S3_BUCKET=cratebase
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=rustfsadmin
# S3_SECRET=rustfsadmin
# S3_FORCE_PATH_STYLE=true

# --- mail -----------------------------------------------------------------
# Unset (default): every send is logged instead of delivered — every
# email-dependent flow (verification, password reset, email change)
# still works end to end for local dev/testing without any provider set
# up. Like S3 above, these seed Settings > Mail on FIRST BOOT ONLY and
# are ignored once `_params` has a settings row.
# CB_APP_NAME=Acme
# CB_APP_URL=http://localhost:8090
# CB_SENDER_NAME=Support
# CB_SENDER_ADDRESS=support@example.com
# SMTP_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# STARTTLS (587/25, most providers) unless true, which is implicit TLS
# (port 465).
# SMTP_TLS=false

# --- AI / embeddings ----------------------------------------------------
# OpenAI-compatible `POST {baseUrl}/embeddings` provider for `vector`
# fields with an `embedding` config. Unset (default): a deterministic,
# network-free fake embedder is used, so vector fields and
# nearest-neighbor search still work end to end without a provider.
# Works unmodified against OpenAI itself or a local Ollama instance's
# OpenAI-compatible endpoint (http://localhost:11434/v1).
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=

# --- js hooks & migrations --------------------------------------------------
# Verbose logging, and pb_hooks/*.pb.js reloaded on change. Also opts
# --automigrate into writing pb_migrations/ even before it exists.
# CB_DEV=false
# Write a pb_migrations/*.js file for every collection created, updated or
# deleted through the dashboard/API, so a fresh environment can replay the
# same schema history. On by default, but a file is only actually written
# once pb_migrations/ exists (create it once to opt in) or CB_DEV=true.
# CB_AUTOMIGRATE=true
# When set, `--dev` rewrites this file with `cratebase typegen`'s output
# every time a collection is created, updated or deleted. Unset means no
# watch; see `cratebase typegen --help` for a one-shot equivalent.
# CB_TYPEGEN_OUT=./cratebase-types.d.ts
