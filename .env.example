# Copy to `.env` and adjust. Every variable has a working default — none
# of this is required to run `cratebase serve` locally.

# --- server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8090
# Comma-separated list, or `*` for any origin (default).
CORS_ALLOW_ORIGINS=*

# --- auth ---------------------------------------------------------------
# HMAC secret for signing session tokens. Leave unset locally: a random
# secret is generated once and persisted to `${CRATEBASE_DATA_DIR}/.auth_secret`.
# Set this explicitly in production (e.g. multi-instance deployments where
# every instance must share the same secret).
AUTH_SECRET=
ADMIN_TOKEN_TTL_SECONDS=604800
AUTH_TOKEN_TTL_SECONDS=1209600

# --- database -----------------------------------------------------------
# Default: sqlite next to the binary. Swap to Postgres for horizontal
# scale/multi-instance deployments — same schema, same API, zero code changes.
#   DATABASE_URL=postgres://cratebase:cratebase@localhost:5432/cratebase
DATABASE_URL=sqlite://./data/cratebase.db
CRATEBASE_DATA_DIR=./data

# --- file storage ---------------------------------------------------------
# `local` (default) or `s3`. `s3` works with AWS S3 and every S3-compatible
# service: RustFS/MinIO for self-hosted dev or prod, Cloudflare R2, Backblaze
# B2, etc. — just point S3_ENDPOINT at it.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage

# S3_BUCKET=cratebase
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=rustfsadmin
# S3_SECRET_ACCESS_KEY=rustfsadmin
# S3_FORCE_PATH_STYLE=true
