# Copy to `.env` and adjust. Every variable has a working default — none
# of this is required to run `cratebase serve` locally.

# --- server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8090
# Comma-separated list, or `*` for any origin (default).
CORS_ALLOW_ORIGINS=*

# --- auth ---------------------------------------------------------------
# HMAC secret for signing session tokens. Leave unset locally: a random
# secret is generated once and persisted to `${CRATEBASE_DATA_DIR}/.auth_secret`.
# Set this explicitly in production (e.g. multi-instance deployments where
# every instance must share the same secret).
AUTH_SECRET=
ADMIN_TOKEN_TTL_SECONDS=604800
AUTH_TOKEN_TTL_SECONDS=1209600
# Per-IP rate limit on the login endpoints (auth-with-password) — blunts
# credential-stuffing/brute-force attempts. On by default; turn off only if
# you're already rate-limiting at a reverse proxy in front of Cratebase.
AUTH_RATE_LIMIT_ENABLED=true
# Base URL of your own web page / mobile deep-link handler that reads
# `?token=` from verification/reset/email-change email links and calls
# the matching `confirm-*` endpoint. Cratebase has no frontend of its own
# for this.
PUBLIC_APP_URL=http://localhost:8090
VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
EMAIL_CHANGE_TOKEN_TTL_SECONDS=3600
# TTL for a one-time OTP code (request-otp/auth-with-otp, and the MFA
# second factor on auth-with-password).
OTP_TOKEN_TTL_SECONDS=300

# --- mailer ---------------------------------------------------------------
# Unset (default): every send is logged instead of delivered — every
# email-dependent flow (verification, password reset, email change) still
# works end to end for local dev/testing without any provider set up.
#   MAIL_DRIVER=resend
#   RESEND_API_KEY=re_xxxxxxxx
#   MAIL_DRIVER=smtp
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_USERNAME=
#   SMTP_PASSWORD=
#   SMTP_IMPLICIT_TLS=false
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME=Cratebase

# --- oauth2 -----------------------------------------------------------------
# OAuth2 (Google, GitHub, or a hand-configured custom provider) is
# configured per auth collection, not here: enable it and add a
# provider's client id/secret from the dashboard's collection editor
# ("Authentication" > "OAuth2"), or via `_collections`' `options.oauth2`
# through the API. "google"/"github" only need a client id and secret;
# their endpoints are built in.

# --- database -----------------------------------------------------------
# Default: sqlite next to the binary. Swap to Postgres for horizontal
# scale/multi-instance deployments — same schema, same API, zero code changes.
#   DATABASE_URL=postgres://cratebase:cratebase@localhost:5432/cratebase
DATABASE_URL=sqlite://./data/cratebase.db
CRATEBASE_DATA_DIR=./data

# --- file storage ---------------------------------------------------------
# `local` (default) or `s3`. `s3` works with AWS S3 and every S3-compatible
# service: RustFS/MinIO for self-hosted dev or prod, Cloudflare R2, Backblaze
# B2, etc. — just point S3_ENDPOINT at it.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage

# S3_BUCKET=cratebase
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=rustfsadmin
# S3_SECRET_ACCESS_KEY=rustfsadmin
# S3_FORCE_PATH_STYLE=true

# Persist every /api/* request to the dashboard's Logs page (default true).
# On SQLite the log lives in a separate <db>.logs.db file so it never
# contends with user traffic.
# LOG_REQUESTS=true

# SQLite connection pool size for a file-backed database. Defaults to one
# per CPU core, clamped to 4..16.
# DATABASE_MAX_CONNECTIONS=8
