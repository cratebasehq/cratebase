# Where the Cratebase server listens. Read on the server only (never sent to the browser).
CRATEBASE_URL=http://127.0.0.1:8090

# Optional: a `cb_…` API key created in the Cratebase dashboard, used by
# `cb.adminClient()` for server-side calls that bypass user rules. Leave empty if unused.
CRATEBASE_API_KEY=
