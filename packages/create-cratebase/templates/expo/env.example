# The URL your Cratebase server listens on. EXPO_PUBLIC_ vars are inlined
# into the app bundle at build time, since the client SDK talks to Cratebase
# directly from the device/browser.
#
# On a physical device or simulator, `localhost` means the device itself —
# use your computer's LAN IP instead (e.g. http://192.168.1.23:8090).
EXPO_PUBLIC_CRATEBASE_URL=http://localhost:8090
