  },
  "homepage": "https://cratebase.dev/docs/getting-started/starter-kits/",
  "bugs": "https://github.com/cratebasehq/cratebase/issues",
  "keywords": ["cratebase", "scaffold", "create-app", "nextjs", "vite", "expo", "pocketbase"],
  "bin": {
